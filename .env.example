NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_APP_MONGO_URL=
NEXT_APP_JWT_SECRET=

# Absolute path where MRD (Medical Records) uploads are stored.
# Locally it defaults to <app>/storage/mrd. In Docker / on a PaaS, mount a
# persistent volume at the container path /surakshya and set this to /surakshya/mrd so
# uploaded files persist across redeploys. Never mount a volume over /app.
MRD_STORAGE_PATH=/surakshya/mrd

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Hospital Management System
SMTP_FROM_EMAIL=
